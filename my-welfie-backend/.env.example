# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/mywellfie
 
# ─── Security ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
 
# ─── BioSense SDK License ─────────────────────────────────────
# Your BioSense Signal license key — never expose this to the client directly
BIOSENSE_LICENSE_KEY=your-license-key-here
 
# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@mywellfie.com
 
# ─── Stripe ───────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Get this after running: stripe listen --forward-to localhost:8001/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here